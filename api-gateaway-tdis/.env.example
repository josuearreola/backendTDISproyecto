# Copia este archivo como .env para desarrollo local.
# En Railway, define estas variables en el panel del servicio (Variables).

# Puerto local. En Railway NO lo definas: Railway inyecta PORT automáticamente.
PORT=8080

# Secreto para firmar/verificar los JWT (HS256).
# Genera uno largo y aleatorio, por ejemplo con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL de Redis. En Railway, al agregar el plugin de Redis, se expone como REDIS_URL.
# Localmente, con Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# URL interna del microservicio de usuarios.
# En Railway será algo como http://user-service.railway.internal:PUERTO
# Localmente: http://localhost:8081
USER_SERVICE_URL=http://localhost:8081

# Origen permitido para CORS (el frontend Angular).
# En producción pon el dominio real, no "*".
ALLOW_ORIGIN=http://localhost:4200
