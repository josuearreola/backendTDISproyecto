# Copia este archivo como .env para desarrollo local.
# En Railway, define estas variables en el panel del servicio.

# Puerto local. En Railway NO lo definas: Railway inyecta PORT.
PORT=8081

# Connection string de Neon. Lo copias del dashboard de Neon.
# Formato típico (incluye sslmode=require, que Neon exige):
# postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# MISMO secreto que el Gateway (ambos deben compartirlo para que el Gateway
# pueda verificar los tokens que este servicio emite).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencia del token en minutos.
JWT_TTL_MINUTES=60
